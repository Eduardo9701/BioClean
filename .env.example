# ==============================================================================
# BIOCLEAN MASTER WEB APP - VARIABLES DE ENTORNO DE EJEMPLO
# ==============================================================================
# Copie este archivo como .env para su entorno de desarrollo o producción.
# NUNCA guarde claves secretas reales en control de versiones.

# Configuración General del Sitio
VITE_APP_NAME="BioClean Master"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:3000"

# Contacto Comercial y WhatsApp (México)
VITE_PHONE_COMMERCIAL="5579247494"
VITE_WHATSAPP_PHONE="525579247494"
VITE_CONTACT_EMAIL="contacto@bioclean.mx"

# Persistencia y Backend (Futura Integración con Supabase / REST API)
# Dejar vacío para operar en modo Demo LocalStorage
VITE_STORAGE_MODE="local" # Opciones: "local" | "supabase" | "rest_api"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-publica-anonima-de-supabase"

# Credenciales Administrativas por Defecto (Sobrescribir en Producción)
VITE_ADMIN_DEFAULT_USER="admin@bioclean.mx"
VITE_ADMIN_SESSION_HOURS=8

# Notificaciones y Webhooks (Opcional)
VITE_WEBHOOK_NEW_QUOTE_URL="" # Ej. Webhook de Make/Zapier para enviar alertas por Slack o Correo
VITE_RESEND_API_KEY=""        # Clave para envío de correos transaccionales vía Resend
